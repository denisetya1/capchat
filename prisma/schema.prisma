// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  fullName          String?
  password          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  instagrams        Instagram[]
  contacts          Contact[]
  automations       Automation[]
}

model Instagram {
  id                String @id @default(cuid())
  userId            String
  User              User  @relation(fields: [userId], references: [id])    
  instagramId       String  @unique
  username          String
  fullName          String?
  profilePictureUrl String?
  authToken         String? @db.Text()
  expired           Int?
  longLiveToken     String? @db.Text()
  refreshToken      String? @db.Text()
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  automationTriggers AutomationTrigger[]

  @@unique([userId, instagramId])
}

model AutomationTriggerType {
  id            Int   @id @default(autoincrement())
  code          String
  title         String
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  automationTriggers AutomationTrigger[]
}

model Automation {
  id            String   @id @default(cuid())
  title         String
  userId        String
  User          User @relation(fields: [userId], references: [id])
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  automationTriggers AutomationTrigger[]
  automationDM  AutomationDM[]
}

model AutomationTrigger {
  id            String   @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id])
  automationTriggerTypeId Int
  automationTriggerType AutomationTriggerType @relation(fields: [automationTriggerTypeId], references: [id])
  instagramId   String?
  instagram     Instagram? @relation(fields: [instagramId], references: [id])
  postId        String?
  postCaption       String?
  postType     String?
  postThumbnailUrl      String?
  postPermalink     String?
  postTimestamp     DateTime?
  isAllPost     Boolean @default(false)
  title         String
  keyword       String?
  isAllComment  Boolean @default(true)
  autoLike      Boolean @default(false)
  isNoReply     Boolean @default(false)
  replies       String? @db.Text()
  isActive      Boolean @default(true)
  runCount      Int @default(0)
  ctrCount      Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      Comment[]
}

model AutomationDM {
  id            String   @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id])
  message       String
  buttons       String? @db.Text()
  sequence      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Comment {
  id            String   @id @default(cuid())
  instagramId   String
  text          String
  timestamp     DateTime
  postId        String
  automationTriggerId String
  automationTrigger AutomationTrigger @relation(fields: [automationTriggerId], references: [id])
  fromIgUserId  String
  fromUsername  String
  linkOpened    Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contact {
  id                String  @id @default(cuid())
  instagramUserId   String
  instagramUsername String?
  userId            String
  user              User @relation(fields: [userId], references: [id])
  tags              String?
  isFollower        Boolean
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}